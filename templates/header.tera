<a class="skip-link" href="#page-content">跳到正文</a>
<header class="site-header">
  <div class="header-inner">
    <a class="network-brand" href="https://icexiv.github.io/" aria-label="IceXIV 首页">
      <svg width="26" height="28" viewBox="0 0 30 32" aria-hidden="true">
        <path d="M15 1 27.5 8.2 15 15.4 2.5 8.2Z" fill="#9dc8ea"/>
        <path d="m2.5 10.7 11 6.35v13L2.5 23.7Z" fill="#4a85bb"/>
        <path d="m16.5 17.05 11-6.35v13l-11 6.35Z" fill="#76acd5"/>
        <path d="m15 5.8 4.3 2.4-4.3 2.5-4.3-2.5Z" fill="#fff" opacity=".8"/>
      </svg><span>IceXIV</span>
    </a>
    <span class="brand-divider" aria-hidden="true"></span>
    <a class="brand" href="{{url(path='index.html')}}" aria-label="IceXIV DB 首页"><img src="{{url(path='logo.png')}}" width="32" height="32" alt="">DB</a>
    <nav class="primary-nav" aria-label="主导航">
      <a href="{{url(path='items/index.html')}}"{% if page.attrs.section == "items" %} aria-current="location"{% endif %}>物品</a>
      <a href="{{url(path='quests/index.html')}}"{% if page.attrs.section == "quests" %} aria-current="location"{% endif %}>任务</a>
    </nav>
    {% set is_quests = page.attrs.section == "quests" %}
    <form id="item-lookup" role="search" action="{% if is_quests %}{{page.root}}quests/index.html{% else %}{{page.root}}items/index.html{% endif %}" data-kind="{% if is_quests %}quest{% else %}item{% endif %}" data-assets="{{page.root}}" data-index="{% if is_quests %}{{page.root}}{{site.data.quests.assetPath}}/index.json{% else %}{{page.root}}{{site.data.catalog.assetPath}}/index.json{% endif %}">
      <label class="lookup-entry">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="m13 13 4 4"/></svg>
        <input type="search" id="lookup-query" name="q" autocomplete="off" aria-keyshortcuts="Control+k Meta+k" aria-label="{% if is_quests %}搜索全部任务{% else %}搜索全部物品{% endif %}" placeholder="{% if is_quests %}搜索任务名称或 ID{% else %}搜索物品名称或 ID{% endif %}">
        <kbd aria-hidden="true">Ctrl + K</kbd>
      </label>
      <div id="lookup-results" aria-label="搜索建议" hidden></div>
    </form>
    <div class="header-actions">
      <a class="header-icon-btn" href="https://github.com/icexiv/icexiv-db" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
          <path d="M9 18c-4.51 2-5-2-7-2"/>
        </svg>
      </a>
      {% if site.data.build and site.data.build.commit %}
      <a class="header-commit-link" href="https://github.com/icexiv/icexiv-db/commit/{{site.data.build.commit}}" target="_blank" rel="noopener noreferrer" aria-label="查看构建提交 {{site.data.build.commit}}" title="{{site.data.build.title}}">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3"/>
          <path d="M3 12h6"/>
          <path d="M15 12h6"/>
        </svg>
        <span>{{site.data.build.commit}}</span>
      </a>
      {% endif %}
    </div>
  </div>
</header>
