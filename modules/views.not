fn item(source: String, index: Int) -> Block {
    let records = read_json(source);
    let record = records.at(index);
    let id = record.at(0).as_string("");
    let name = record.at(1).as_string("");
    let description = record.at(2).as_string("");
    let category = record.at(3).as_string("");
    let search_category = record.at(4).as_string("");
    let equip_level = record.at(5).as_string("");
    let rarity = record.at(6).as_string("");
    let stack_size = record.at(7).as_string("");
    let unique = record.at(8).as_string("");
    let untradable = record.at(9).as_string("");
    let hq = record.at(10).as_string("");
    let icon = record.at(11).as_string("");
    let icon_url = record.at(12).as_string("");
    let description_label = if description == "" { "暂无描述。" } else { description };
    let kind = record.at(13).as_string("");
    let ilvl = record.at(14).as_string("");
    let subhead = kind + " · No. " + id;
    let back = para(link("/items/index.html", text("← 物品目录"))).with_attr("class", "back-link");
    let icon_p = para(image(icon_url, "")).with_attr("class", "item-icon item-icon-detail");
    let desc_p = para(text(description_label))
        .with_attr("id", "item-description")
        .with_attr("class", "description");
    let identity = para(strong(text("物品 ID")) + text(" ") + text(id));
    let equipment = if ilvl == "" { identity } else {
        identity + para(strong(text("物品品级")) + text(" ") + text(ilvl))
        + para(strong(text("装备等级")) + text(" ") + text(equip_level))
        + para(strong(text("装备部位")) + text(" ") + text(record.at(15).as_string("")))
        + para(strong(text("适用职业")) + text(" ") + text(record.at(16).as_string("")))
    };
    let fields = div(
        equipment
        + para(strong(text("首次收录版本")) + text(" ") + text(record.at(17).as_string("")))
        + para(strong(text("分类 ID")) + text(" ") + text(category))
        + para(strong(text("搜索分类 ID")) + text(" ") + text(search_category))
        + para(strong(text("稀有度")) + text(" ") + text(rarity))
        + para(strong(text("堆叠上限")) + text(" ") + text(stack_size))
        + para(strong(text("独占")) + text(" ") + text(unique))
        + para(strong(text("不可交易")) + text(" ") + text(untradable))
        + para(strong(text("可 HQ")) + text(" ") + text(hq))
        + para(strong(text("图标 ID")) + text(" ") + text(icon))
    )
    .with_attr("id", "item-fields")
    .with_attr("class", "item-fields");
    let notice = section(
        heading(2, text("获取途径"))
        + para(text("此版本只接入 Item 表，尚未收录来源。不能据此判断物品不可获得。"))
    )
    .with_attr("class", "notice");
    let detail_content = div(desc_p + fields + notice).with_attr("id", "detail-content");
    let item_detail = section(
        icon_p
        + heading(1, text(name))
        + para(text(subhead)).with_attr("class", "muted")
        + detail_content
    )
    .with_attr("id", "item-detail");
    back + item_detail
}

fn catalog(source: String) -> Block {
    let page = read_json(source);
    let count = page.get("count").as_int(0);
    let version = page.get("version").as_string("");
    let page_size = page.get("pageSize").as_int(0);
    let label = page.get("label").as_string("");
    let previous_path = page.get("previous").as_string("");
    let next_path = page.get("next").as_string("");
    let records = page.get("items").as_list();
    let rows = for record in records {
        let id = record.at(0).as_string("");
        let name = record.at(1).as_string("");
        let category = record.at(2).as_string("");
        let icon_url = record.at(3).as_string("");
        let target = "/items/" + id + ".html";
        let name_cell = image(icon_url, "").with_attr("class", "item-icon")
            + text(" ")
            + link(target, text(name));
        (text(id), name_cell, text(category))
    };
    let previous = if previous_path == "" {
        []
    } else {
        link(previous_path, text("上一页"))
    };
    let next = if next_path == "" {
        []
    } else {
        link(next_path, text("下一页"))
    };
    let count_label = count.to_string() + " 件物品";
    let version_label = "客户端 " + version;
    let page_label = " " + label + " ";
    let status_label = "每页 " + page_size.to_string() + " 件 · " + label;
    let tbl = table((text("编号"), text("物品名称"), text("类型")), rows);
    let table_wrap = div(tbl).with_attr("class", "table-scroll");
    let pagination = para(previous + text(page_label) + next)
        .with_attr("class", "pagination")
        .with_attr("aria-label", "静态物品目录分页");
    let catalog_box = div(
        para(text(status_label)).with_attr("id", "catalog-status")
        + table_wrap
        + pagination
    )
    .with_attr("id", "catalog");
    heading(1, text("物品图鉴"))
        + para(text("艾欧泽亚的装备、素材与道具")).with_attr("class", "intro")
        + para(text("国服收录 · " + count_label)).with_attr("class", "source-note")
        + catalog_box
}
