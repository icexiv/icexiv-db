fn item(source: Path, index: Int) -> BlockContent {
    let records = data_expect<Data>(read_json(source));
    let record = data_expect<Data>(data_require_index<Data>(records, index));
    let id = data_expect<String>(data_require_index<String>(record, 0));
    let name = data_expect<String>(data_require_index<String>(record, 1));
    let description = data_expect<String>(data_require_index<String>(record, 2));
    let category = data_expect<String>(data_require_index<String>(record, 3));
    let search_category = data_expect<String>(data_require_index<String>(record, 4));
    let equip_level = data_expect<String>(data_require_index<String>(record, 5));
    let rarity = data_expect<String>(data_require_index<String>(record, 6));
    let stack_size = data_expect<String>(data_require_index<String>(record, 7));
    let unique = data_expect<String>(data_require_index<String>(record, 8));
    let untradable = data_expect<String>(data_require_index<String>(record, 9));
    let hq = data_expect<String>(data_require_index<String>(record, 10));
    let icon = data_expect<String>(data_require_index<String>(record, 11));
    let icon_url = data_expect<String>(data_require_index<String>(record, 12));
    let description_label = if description == "" { "暂无描述。" } else { description };
    let subhead = "物品 #" + id + " · 固定版本数据";
    [
        @(class: "back-link")#paragraph()[#link(target: "/items/index.html")[#text(text: "← 物品目录")]]

        @(id: "item-detail")#section[
            @(class: "item-icon item-icon-detail")#paragraph()[#embed(target: "../content" + icon_url, description: "")]

            #heading<1>[#text(text: name)]

            @(class: "muted")#paragraph()[#text(text: subhead)]

            @(id: "detail-content")#node<BlockContent>[
                @(id: "item-description", class: "description")#paragraph()[#text(text: description_label)]

                @(id: "item-fields", class: "item-fields")#node<BlockContent>[
                    #paragraph()[#strong[#text(text: "物品 ID")] #text(text: id)]

                    #paragraph()[#strong[#text(text: "分类 ID")] #text(text: category)]

                    #paragraph()[#strong[#text(text: "搜索分类 ID")] #text(text: search_category)]

                    #paragraph()[#strong[#text(text: "装备等级")] #text(text: equip_level)]

                    #paragraph()[#strong[#text(text: "稀有度")] #text(text: rarity)]

                    #paragraph()[#strong[#text(text: "堆叠上限")] #text(text: stack_size)]

                    #paragraph()[#strong[#text(text: "独占")] #text(text: unique)]

                    #paragraph()[#strong[#text(text: "不可交易")] #text(text: untradable)]

                    #paragraph()[#strong[#text(text: "可 HQ")] #text(text: hq)]

                    #paragraph()[#strong[#text(text: "图标 ID")] #text(text: icon)]
                ]

                @(class: "notice")#section[
                    #heading<2>[#text(text: "获取途径")]

                    #paragraph()[#text(text: "此版本只接入 Item 表，尚未收录来源。不能据此判断物品不可获得。")]
                ]
            ]
        ]
    ]
}

fn catalog(source: Path) -> BlockContent {
    let page = data_expect<Data>(read_json(source));
    let count = data_expect<Int>(data_require<Int>(page, "count"));
    let version = data_expect<String>(data_require<String>(page, "version"));
    let page_size = data_expect<Int>(data_require<Int>(page, "pageSize"));
    let source_url = data_expect<String>(data_require<String>(page, "sourceUrl"));
    let label = data_expect<String>(data_require<String>(page, "label"));
    let previous_path = data_expect<String>(data_require<String>(page, "previous"));
    let next_path = data_expect<String>(data_require<String>(page, "next"));
    let records_data = data_expect<Data>(data_require<Data>(page, "items"));
    let records = data_expect<Array<Data>>(data_decode<Array<Data>>(records_data));
    let rows = for record in records {
        let id = data_expect<String>(data_require_index<String>(record, 0));
        let name = data_expect<String>(data_require_index<String>(record, 1));
        let category = data_expect<String>(data_require_index<String>(record, 2));
        let icon_url = data_expect<String>(data_require_index<String>(record, 3));
        let target = "/items/" + id + ".html";
        row()[
            @(class: "numeric")#cell()[#text(text: id)]

            #cell()[@(class: "item-icon")#embed(target: "../content" + icon_url, description: "") #link(target: target)[#text(text: name)]]

            @(class: "numeric")#cell()[#text(text: category)]
        ]
    };
    let previous = if previous_path == "" {
        []
    } else {
        [#link(target: previous_path)[#text(text: "上一页")]]
    };
    let next = if next_path == "" {
        []
    } else {
        [#link(target: next_path)[#text(text: "下一页")]]
    };
    let page_size_label = str(page_size);
    let count_label = str(count) + " 件物品";
    let version_label = "客户端 " + version;
    let page_label = " " + label + " ";
    let status_label = "每页 " + page_size_label + " 件条目。所有条目和详情均为静态页面；启用 JavaScript 可搜索。";
    [
        #heading<1>[#text(text: "物品目录")]

        #paragraph()[#text(text: "国服客户端中有名称的 Item 条目，不限于可交易物品。条目存在不代表当前仍可获得。")]

        @(class: "source-note")#paragraph()[#strong[#text(text: count_label)] #text(text: " ") #text(text: version_label) #text(text: " ") #link(target: source_url)[#text(text: "原始 CSV")]]

        @(id: "catalog")#node<BlockContent>[
            @(id: "catalog-status")#paragraph()[#text(text: status_label)]

            @(class: "table-scroll")#node<BlockContent>[
                #table[
                    #row(header: true)[#cell[#text(text: "ID")] #cell[#text(text: "物品名称")] #cell[#text(text: "分类 ID")]]

                    #rows
                ]
            ]

            @(class: "pagination", aria-label: "静态物品目录分页")#paragraph()[#previous #text(text: page_label) #next]
        ]

        @(class: "muted")#paragraph()[#text(text: "分类展示原始 ID。问号表示没有配置或未提供图标资源；获取途径未收录。")]
    ]
}
